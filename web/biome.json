{
  "files": {
    "includes": [
      "src/**/*.ts",
      "vite.config.ts",
      "svelte.config.js",
      "*.json",
      "!openapi.json",
      "!src/lib/api-schema.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  }
}
